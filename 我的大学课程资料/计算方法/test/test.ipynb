   "source": [
    "with open('test.txt', 'r') as f:\n",
    "    data = f.readlines()\n",
    "\n",
    "# 将每行的数字分割并转换为整数\n",
    "numbers = []\n",
    "for line in data:\n",
    "    # 分割每行的数字并转换为整数\n",
    "    numbers.extend([int(num) for num in line.strip().split()])\n",
    "\n",
    "# 排序\n",
    "numbers.sort()\n",
    "print(numbers)"
   ]
  }
 ],
